{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "togetoge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets OpenNext call back into this worker (cache revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "togetoge"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "togetoge",
      // Placeholder. Replace with the id printed by `wrangler d1 create togetoge`
      // (see the cutover runbook in the PR / README) before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
