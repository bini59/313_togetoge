{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "togetoge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "togetoge.bini59.dev", "custom_domain": true }
  ],
  "services": [
    {
      // Lets OpenNext call back into this worker (cache revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "togetoge"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "togetoge",
      "database_id": "832e69b6-14e5-48bd-b0aa-997d6eae1b86",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
